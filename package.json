{
  "name": "ben-dsh-crawl4ai",
  "version": "0.1.0",
  "description": "Crawl4AI-backed web fetch provider for DeepSeek Harness — web_fetch renders JavaScript-heavy pages through your own Crawl4AI server and returns clean Markdown.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "crawl4ai",
    "web-fetch"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "scripts/**/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "link-harness-deps": "node scripts/link-harness-deps.mjs",
    "test": "node --test test/crawl4ai.test.mjs test/config.test.mjs test/client.test.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
